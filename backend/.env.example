# Backend-only configuration. Copy to .env and provide your local database URL.
DATABASE_URL=postgresql+psycopg://apple@127.0.0.1:5432/prep_buddy
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Local HTTP only; omit or set true for production HTTPS.
SESSION_COOKIE_SECURE=false
# Do not trust client-supplied forwarding headers for IP rate limits.
FORWARDED_ALLOW_IPS=
